{
  "manifest_version": 3,
  "name": "CashConvert",
  "version": "1.1.0",
  "description": "Live exchange rates for major world currencies, with a built-in converter.",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://api.frankfurter.app/*"],
  "action": {
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
